; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ETA: Unknown"
config/name_localized={
"pl_PL": "ETA: Nieznana"
}
config/version="0.1.0"
run/main_scene="res://systems/scenes/empty_scene.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GlobalRefs="*res://systems/global_refs/global_refs.tscn"
GlobalTimer="*res://systems/global_timer/global_timer.tscn"
GameManager="*res://systems/game_manager/game_manager.tscn"
DebugTools="*res://systems/tools/debug_tools.tscn"
ActionLogger="*res://systems/action_logger/action_logger.tscn"
SaveManager="*res://systems/save_manager/save_manager.tscn"
GlobalMarket="*res://systems/global_market/global_market.tscn"
EmailServer="*res://systems/email_server/email_server.tscn"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/inferred_declaration=2

[editor_plugins]

enabled=PackedStringArray()

[file_customization]

folder_colors={
"res://addons/": "red",
"res://entities/": "blue",
"res://master_data/": "purple",
"res://sound/": "yellow",
"res://systems/": "teal"
}

[gui]

theme/custom="uid://ukt8dgouxdxt"
theme/custom_font="uid://cs1yn8q07d5k4"
theme/default_font_hinting=2
theme/default_font_multichannel_signed_distance_field=true

