script = ExtResource("1_ndiir")
category_name = "Training and Certifications"
category_description = "These formal qualifications allow you to handle specific goods (like DG), operate in specific markets, or lead teams. They serve as gatekeepers to higher-tier missions, industry perks, and client trust. Earning certifications unlocks new cargo types, raises your reputation, and expands your operational capabilities."
