category_name = "Freight Forwarding"
category_description = "This is the core skill set of any logistics professional - handling shipments from quote to delivery. It includes tasks like documentation, pricing, carrier coordination, and cargo movement. In-game, these skills directly impact shipment efficiency, client satisfaction, and your ability to take on more complex jobs."
