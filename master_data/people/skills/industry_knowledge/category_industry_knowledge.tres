script = ExtResource("1_p27ia")
category_name = "Industry Knowledge"
category_description = "These skills represent your understanding of how global logistics actually works - trade lanes, Incoterms, commodity handling, and geopolitical awareness. They help you make informed decisions, avoid disruptions, and gain access to specialized contracts. A high level of industry knowledge unlocks advanced routing, niche markets, and strategic bonuses."
