script = ExtResource("1_d6t76")
category_name = "Tech Fluency"
category_description = "Modern logistics relies heavily on digital tools, from TMS platforms to spreadsheets and printers. This category covers your ability to operate office equipment and software efficiently, automate workflows, and solve tech issues. It boosts your personal productivity, reduces task delays, and unlocks tech-related shortcuts and automations."
