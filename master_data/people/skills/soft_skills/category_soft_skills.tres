script = ExtResource("1_so01h")
category_name = "Soft Skills"
category_description = "Logistics isn’t just about moving freight - it’s about working with people under pressure. These interpersonal and cognitive skills determine how well you handle multitasking, leadership, communication, and stress. Improving soft skills reduces conflict, boosts team performance, and unlocks leadership opportunities."
